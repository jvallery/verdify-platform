# Derived TimescaleDB runtime for verdify-prod (fleet control-plane #5787, Wave 2.5 item 1.1).
#
# Same PostgreSQL 16.11 and TimescaleDB 2.25.2 as the upstream image it replaces
# (timescale/timescaledb:2.25.2-pg16, the linux/amd64 manifest pinned below), so the
# live data directory and extension version do not change. Changes:
#   * Remove the bundled Go tools timescaledb-parallel-copy and timescaledb-tune
#     (Critical findings in Go stdlib 1.22.4/1.24.6 and pgx v5.7.2). Nothing in this
#     repository runs either one. NO_TS_TUNE=true makes a fresh initdb skip the
#     upstream 001_timescaledb_tune.sh script instead of calling the removed binary.
#   * Remove /usr/local/bin/gosu, the last Go binary (Go stdlib go1.24.6:
#     CVE-2025-68121 Critical plus 25 High, #1458). docker-entrypoint.sh execs gosu
#     only when the container starts as uid 0; every consumer in verdify-prod runs
#     runAsNonRoot as uid 999 or 1000, so it is never executed. This image can no
#     longer start as root; run it as uid 999 (postgres).
#   * Apply the Alpine 3.21 security updates to every installed apk package
#     (OpenSSL CVE-2026-31789 fixed in 3.3.7-r0, plus the musl, zlib and libxml2
#     Highs from the 2026-11-07 estate scan, #1458). PostgreSQL and TimescaleDB are
#     built from source under /usr/local and are not apk packages, so their
#     versions are unchanged (asserted below).
# Built in-cluster by the repo-build-verdifyconsultancy Kaniko workflow and pinned by
# digest in deploy/k8s/overlays/prod/kustomization.yaml.
FROM docker.io/timescale/timescaledb:2.25.2-pg16@sha256:5d523957b04041e1c8dc776dd086a2d68fd1ebc9d4ac3e948b65f02c88550140

RUN set -eux; \
    apk upgrade --no-cache; \
    rm -f /usr/local/bin/timescaledb-parallel-copy /usr/local/bin/timescaledb-tune /usr/local/bin/gosu; \
    test ! -e /usr/local/bin/timescaledb-parallel-copy; \
    test ! -e /usr/local/bin/timescaledb-tune; \
    test ! -e /usr/local/bin/gosu; \
    if command -v gosu; then exit 1; fi; \
    test -e /usr/local/lib/postgresql/timescaledb-2.25.2.so; \
    postgres --version | grep -q ' 16\.11'; \
    for pkg in libssl3 libcrypto3; do \
        v="$(apk list --installed "$pkg" | awk '{print $1}' | sed "s/^$pkg-//")"; \
        test -n "$v"; \
        apk version -t "$v" 3.3.7-r0 | grep -q '[=>]'; \
    done

ENV NO_TS_TUNE=true
